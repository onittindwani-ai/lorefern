# Replace the name with your own DNS name. Caddy gets HTTPS certificates by itself.
app.example.com {
	encode zstd gzip
	request_body {
		max_size 25MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	reverse_proxy 127.0.0.1:3000
}

# Only when the web app runs on Vercel (docs/06) and needs a public API address. Otherwise leave this block out: the web app reaches the API inside the compose network,
# and the API port is bound to 127.0.0.1 only.

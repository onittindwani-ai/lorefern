# Lorefern environment. Names only. Copy to .env and fill in what you use. Never commit .env.
# A group of settings you leave empty is treated as switched off. An empty line means "not set".
# This file is for a real install, so DEMO_MODE is false. To look around with the sample company, set DEMO_MODE=true and leave OWNER_PASSWORD_HASH empty.

# Core
APP_NAME=lorefern
DATABASE_URL=sqlite:///./lorefern.sqlite3
# Replace this with 32 or more random characters: python3 -c "import secrets; print(secrets.token_urlsafe(48))". With DEMO_MODE=false the API refuses to start on this example value.
SESSION_SECRET=change-me-to-a-long-random-string
# draft sends nothing. live lets a second person send reminders. The app refuses live while COMPANY_NAME and EMAIL_FROM are still the demo values.
MODE=draft
DEMO_MODE=false
KILL_SWITCH=false
# The API refuses DEMO_MODE=true on a Postgres database unless you allow it here, for a throw away trial.
ALLOW_DEMO_SERVER=false
# The largest request the API reads, in bytes (25 MB).
MAX_BODY_BYTES=26214400
COMPANY_NAME=Pinegate Works
# The zone in which "today" is worked out, for example Europe/Berlin or America/Chicago.
TIMEZONE=UTC
KNOWLEDGE_DIR=
SEED_DIR=

# Owner login (DEMO_MODE off needs a real password hash, see tools/hash_password.py). Keep the hash in single quotes, it contains $ characters.
OWNER_EMAIL=owner@example.test
OWNER_PASSWORD_HASH=
APPROVER_EMAIL=
APPROVER_PASSWORD_HASH=
# Sign in tries in a row before a short wait. Leave at 5 outside tests.
LOGIN_BURST=5
# Everyone else who may sign in: {"name@company.com": {"audience": "staff", "password_hash": "..."}}. Audiences: leadership, finance, staff.
MEMBERS_JSON=

# Which adapters to use (seed means offline)
KNOWLEDGE_ADAPTER=seed
MEETINGS_ADAPTER=seed
EMAIL_ADAPTER=seed

# What a language model may do. offline (the default) calls nothing. fixture replays recorded answers. anthropic calls a real model and needs ANTHROPIC_API_KEY.
LLM_MODE=fixture
LLM_BACKEND=offline
ANSWER_WRITER=model
MEETING_EXTRACTOR=rules
PROCESS_WORDING=rules
REVIEW_WRITER=rules

# The Anthropic key, only for LLM_BACKEND=anthropic. Keep it in the host's secret settings.
ANTHROPIC_API_KEY=
# The Anthropic address and version header. Change them only for a test server or a proxy.
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2026-10-21
# The two model names and an optional single model for both.
LLM_HARD_MODEL=claude-sonnet-5-5
LLM_BULK_MODEL=claude-haiku-5-5
LLM_MODEL=
# Seconds per request, the reply limit, and retries after a failed try.
LLM_TIMEOUT=120
LLM_MAX_TOKENS=4096
LLM_MAX_RETRIES=2
# The most live calls per process, and the most tracked spend in US dollars. Empty means no limit.
LLM_CALL_BUDGET=
LLM_BUDGET_USD=
# default or off (the lowest thinking setting where the model allows it).
LLM_THINKING=default
# Where recorded answers are read from, and whether every live answer is saved there.
LLM_FIXTURES_DIR=
LLM_RECORD=false
# Hide full prompts and keys from logs and fixtures, and log a shortened prompt.
LLM_REDACT=true
LLM_LOG_PROMPTS=false

# Most meetings one read may remove from the app. A bigger drop (a recorder that lost its key, a deleted folder) waits until the owner presses Confirm on the Sources page.
MEETINGS_MAX_REMOVALS=5

# Task rules. Decided defaults, a starting point: change them to the client's real working week and limits
WORKING_DAYS=Mon,Tue,Wed,Thu,Fri
STUCK_NO_UPDATE_DAYS=10
STUCK_BLOCKED_DAYS=5
OVERLOAD_OPEN_TASKS=8
OVERLOAD_DUE_SOON=5
SOP_REVIEW_DAYS=180
WEEKLY_REVIEW_WEEKDAY=0

# Google Drive source: fill in ONE of the three ways (the first one found is used)
DRIVE_SERVICE_ACCOUNT_JSON=
DRIVE_SERVICE_ACCOUNT_FILE=
DRIVE_CLIENT_ID=
DRIVE_CLIENT_SECRET=
DRIVE_REFRESH_TOKEN=
DRIVE_TOKEN=
DRIVE_SUBJECT=
# Drive addresses and the read only scope. Change them only for a test server.
DRIVE_SCOPE=https://www.googleapis.com/auth/drive.readonly
DRIVE_TOKEN_URI=https://oauth2.googleapis.com/token
DRIVE_BASE_URL=https://www.googleapis.com

# Notion source
NOTION_TOKEN=
# The Notion address. Change it only for a test server.
NOTION_BASE_URL=https://api.notion.com

# Fireflies meetings
FIREFLIES_TOKEN=
# The Fireflies address. Change it only for a test server.
FIREFLIES_BASE_URL=https://api.fireflies.ai

# Fathom meetings
FATHOM_TOKEN=
# The Fathom address. Change it only for a test server.
FATHOM_BASE_URL=https://api.fathom.ai

# Email out for task reminders. EMAIL_FROM must be an address you control. TLS must stay on for a mail server that is not this machine.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=lorefern@example.test
# Domains task reminders may be sent to and task owners may have, comma separated (a sub domain counts). Required outside demo mode: while it is empty no reminder is sent and no task owner can have an address. Never a free mail provider such as gmail.com.
ALLOWED_EMAIL_DOMAINS=

# Docker only: the password of the Postgres container. Letters and digits only (openssl rand -hex 24), because it sits inside DATABASE_URL.
POSTGRES_PASSWORD=

# Web app (set on the web host)
API_BASE_URL=http://127.0.0.1:8000
